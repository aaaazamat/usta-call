# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL in production, SQLite by default in dev)
DATABASE_URL=sqlite:///db.sqlite3
# Example for postgres:
# DATABASE_URL=postgres://usta:usta@localhost:5432/usta_call

# Redis (Channels + Celery)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_LIFETIME_MIN=60
JWT_REFRESH_LIFETIME_DAYS=14

# CORS (Next.js frontend dev)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI (matching) — gemini|anthropic|openai|keyword
# Gemini bepul: https://aistudio.google.com/app/apikey (kuniga 1500 so'rov)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Bir nechta kalit (vergul bilan): biri limitga yetsa avtomatik keyingisiga o'tadi
# GEMINI_API_KEYS=kalit1,kalit2
GEMINI_API_KEYS=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# SMS / OTP — console | telegram | eskiz
# Eng yaxshi: telegram (bepul, mahalliy)
SMS_PROVIDER=telegram

# Telegram bot (https://t.me/BotFather → /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Eskiz.uz SMS (pulli — agar Telegram o'rniga ishlatish kerak bo'lsa)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Media storage
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# Sentry
SENTRY_DSN=
